{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sieve.local/finding.schema.json",
  "title": "SIEVE Finding",
  "type": "object",
  "required": ["task_id", "verdict", "severity", "detail", "reproducer", "evidence_tier"],
  "properties": {
    "task_id": {"type": "string"},
    "verdict": {"type": "string"},
    "secondary": {"type": "array", "items": {"type": "string"}},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "detail": {"type": "string"},
    "reproducer": {"type": "string"},
    "evidence_tier": {"type": "string"},
    "fp_lower_bound": {"type": "boolean"}
  }
}

